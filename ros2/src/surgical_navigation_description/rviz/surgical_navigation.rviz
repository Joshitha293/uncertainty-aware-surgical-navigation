Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Displays:

    - Alpha: 0.5
      Cell Size: 0.05
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20

    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Surgical Instrument
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Names: true

  Enabled: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: robot_base
    Frame Rate: 30

  Name: root

Window Geometry:
  Height: 900
  Width: 1400