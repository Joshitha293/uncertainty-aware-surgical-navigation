<?xml version="1.0"?>
<sdf version="1.9">
  <model name="surgical_research_scene">
    <!-- Align model origin with Gazebo robot_base spawn height. -->
    <pose>0 0 0.10 0 0 0</pose>
    <static>true</static>

    <link name="scene">

      <!-- BODY / OPERATIVE WORKSPACE -->
      <visual name="body_workspace">
        <pose>0.13 0.00 0.045 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.16 0.09</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.45 0.55 1</ambient>
          <diffuse>0.95 0.45 0.55 1</diffuse>
        </material>
        <transparency>0.88</transparency>
        <cast_shadows>false</cast_shadows>
      </visual>

      <!-- TRUE / PROTECTED ANATOMY -->
      <visual name="anatomy_true">
        <pose>0.14 0.04 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.028</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.75 0.02 0.02 1</ambient>
          <diffuse>0.75 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <!--
        Visual anatomical context only.
        The central protected sphere above remains the research-core
        collision / safety representation.
      -->

      <visual name="anatomy_context_lobe_1">
        <pose>0.155 0.052 0.040 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.020</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.55 0.03 0.04 1</ambient>
          <diffuse>0.55 0.03 0.04 1</diffuse>
        </material>
        <transparency>0.18</transparency>
      </visual>

      <visual name="anatomy_context_lobe_2">
        <pose>0.127 0.050 0.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.018</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.62 0.04 0.05 1</ambient>
          <diffuse>0.62 0.04 0.05 1</diffuse>
        </material>
        <transparency>0.20</transparency>
      </visual>

      <visual name="anatomy_context_lobe_3">
        <pose>0.145 0.024 0.028 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.017</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.48 0.02 0.03 1</ambient>
          <diffuse>0.48 0.02 0.03 1</diffuse>
        </material>
        <transparency>0.22</transparency>
      </visual>

      <!-- SAFETY SHELL -->
      <visual name="safety_shell">
        <pose>0.14 0.04 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.045</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.85 0.10 1</ambient>
          <diffuse>1.0 0.85 0.10 1</diffuse>
        </material>
        <transparency>0.50</transparency>
        <cast_shadows>false</cast_shadows>
      </visual>

      <!-- UNCERTAINTY SHELL -->
      <visual name="uncertainty_shell">
        <pose>0.14 0.04 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.100</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.35 0.02 1</ambient>
          <diffuse>1.0 0.35 0.02 1</diffuse>
        </material>
        <transparency>0.60</transparency>
        <cast_shadows>false</cast_shadows>
      </visual>

      <!-- Surgical target crosshair -->
      <visual name="target_crosshair_x">
        <pose>0.10 0.00 0.02 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 1.0 0.10 1</ambient>
          <diffuse>0.05 1.0 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="target_crosshair_y">
        <pose>0.10 0.00 0.02 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 1.0 0.10 1</ambient>
          <diffuse>0.05 1.0 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="target_crosshair_z">
        <pose>0.10 0.00 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 1.0 0.10 1</ambient>
          <diffuse>0.05 1.0 0.10 1</diffuse>
        </material>
      </visual>

      <!-- TARGET -->
      <visual name="surgical_target">
        <pose>0.10 0.00 0.02 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.010</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.05 1.0 0.10 1</ambient>
          <diffuse>0.05 1.0 0.10 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
